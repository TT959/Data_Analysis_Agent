# 模型接口
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini

# 分阶段模型
#规划agent用的模型
PLANNER_MODEL=gpt-4o-mini
#分析agent用的模型
ANALYST_MODEL=gpt-4o
# 出图agent用的模型
VISUALIZER_MODEL=gpt-4o-mini
# 报告agent用的模型
REPORTER_MODEL=gpt-4o-mini
# 复核agent用的模型
CRITIC_MODEL=gpt-4o-mini

# 服务 
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
API_KEYS=dev-key-change-me
LOG_LEVEL=INFO
# true=JSON 日志，便于采集
LOG_JSON=false

# ===== 路径与上传 =====
DATA_DIR=./src/data
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
CHARTS_DIR=./outputs/charts
REPORTS_DIR=./outputs/reports
# 上传大小上限（MB）
MAX_UPLOAD_MB=20
# 最大行数上限
MAX_ROWS=50000
# 最大列数
MAX_COLUMNS=200
# 超行数上限时抽样（true）或直接拒绝（false）
ENABLE_ROW_SAMPLING=true
ALLOWED_EXTENSIONS=.csv,.xlsx
CODE_EXEC_TIMEOUT=30
ALLOW_CODE_EXECUTION=true

# 调用限制 
# LLM 超时时间（秒）
LLM_TIMEOUT_SECONDS=60
# LLM 最大重试次数
LLM_MAX_RETRIES=3
# 每个agent的最大步骤数
AGENT_MAX_STEPS=15
# 复核agent的最大回合数
CRITIC_MAX_ROUNDS=2


# memory: API 进程内 BackgroundTasks
# celery: 需 Redis + Worker
TASK_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_QUEUE=analysis
# 任务超时时间（秒）
JOB_TIMEOUT_SECONDS=600
# 任务最大重试次数
JOB_MAX_RETRIES=2
# 工作线程并发数
WORKER_CONCURRENCY=2
# Worker Prometheus 端口
WORKER_METRICS_PORT=9091
# 任务过期时间（秒）
JOB_TTL_SECONDS=604800

# 对象存储（local 或 s3/MinIO）
# local 只写本地盘；s3 同步到 MinIO/S3
STORAGE_BACKEND=local
# MinIO/S3 地址
S3_ENDPOINT=http://127.0.0.1:9000
# MinIO/S3 访问密钥
S3_ACCESS_KEY=minioadmin
# MinIO/S3 秘密密钥
S3_SECRET_KEY=minioadmin
# MinIO/S3 桶名
S3_BUCKET=analyst
# MinIO/S3 区域
S3_REGION=us-east-1
# 结果保留天数
ARTIFACT_RETAIN_DAYS=7

# 结果缓存
ENABLE_RESULT_CACHE=true
RESULT_CACHE_TTL_SECONDS=86400
